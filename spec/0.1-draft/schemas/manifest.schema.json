{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.prooflane.dev/0.1-draft/manifest.schema.json",
  "$comment": "errorPrefix: MANIFEST | missingRequired: ERR_MANIFEST_MISSING_REQUIRED | typeInvalid: ERR_MANIFEST_TYPE_INVALID",
  "title": "Prooflane Manifest",
  "type": "object",
  "required": [
    "format",
    "spec_version",
    "title",
    "created",
    "doc_id",
    "latest_commit",
    "commits",
    "workflow"
  ],
  "properties": {
    "format": {
      "$comment": "ERR_MANIFEST_FORMAT_INVALID",
      "const": "PROOFLANE"
    },
    "spec_version": {
      "$comment": "ERR_MANIFEST_SPEC_VERSION_INVALID",
      "type": "string",
      "enum": [
        "0.1",
        "0.1-draft"
      ]
    },
    "title": {
      "$comment": "ERR_MANIFEST_TITLE_INVALID",
      "type": "string"
    },
    "created": {
      "$comment": "ERR_MANIFEST_CREATED_INVALID",
      "type": "string",
      "format": "date-time"
    },
    "doc_id": {
      "$comment": "ERR_MANIFEST_DOC_ID_INVALID",
      "type": "string"
    },
    "latest_commit": {
      "$comment": "ERR_MANIFEST_LATEST_COMMIT_INVALID",
      "type": "string"
    },
    "commits": {
      "$comment": "ERR_MANIFEST_COMMITS_INVALID",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "workflow": {
      "$comment": "ERR_MANIFEST_WORKFLOW_INVALID",
      "type": "object"
    },
    "search": {
      "$comment": "ERR_MANIFEST_SEARCH_INVALID",
      "type": "object"
    },
    "security": {
      "$comment": "ERR_MANIFEST_SECURITY_INVALID",
      "type": "object"
    }
  }
}